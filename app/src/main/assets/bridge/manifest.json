{
  "manifest_version": 2,
  "name": "webos-bridge",
  "version": "1.0",
  "description": "Exposes window.Native (power, keys, sensors, files, root, ...) to the web OS",
  "browser_specific_settings": { "gecko": { "id": "bridge@webos.app" } },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_start",
      "all_frames": false
    }
  ],
  "background": { "scripts": ["background.js"] },
  "permissions": ["nativeMessaging", "nativeMessagingFromContent", "geckoViewAddons"]
}
